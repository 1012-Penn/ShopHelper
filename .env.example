# 复制为 .env 并填入真实值;.env 不进 git
# 对话:智谱 GLM(OpenAI 兼容接口,https://open.bigmodel.cn 申请 key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4.7-flash
# 其他 OpenAI 兼容上游(如 DeepSeek)改后两行即可:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# ch07 新增:上下文预算从模型窗口倒推(历史预算=min(想留轮数×每轮稳态, 滑窗),层1 七成/层2 三成)
# 只调 MODEL_CONTEXT_WINDOW 不够:固定开销与单轮峰值按其余默认值算,窗口过小会滑窗归零并报「上下文预算不足」
# MODEL_CONTEXT_WINDOW=65536
# MAX_OUTPUT_TOKENS=2000
# MAX_USER_INPUT_TOKENS=2000
# MAX_AGENT_STEPS=6
# TOOL_RESULT_MAX_TOKENS=2000
# RERANK_TOP_K=10
CHAT_TEMPERATURE=0.7
EXTRACT_TEMPERATURE=0
# auto: DeepSeek thinking 使用 JSON+Pydantic；function_calling 保留原生工具调用
# STRUCTURED_OUTPUT_MODE=auto
# ch02 新增:MySQL 连接串(Docker 起库后默认值即可用)
DATABASE_URL=mysql+pymysql://shophelper:shophelper@127.0.0.1:3306/shophelper?charset=utf8mb4
# ch03 新增:BGE-M3 嵌入(硅基流动 OpenAI 兼容接口,https://cloud.siliconflow.cn 申请 key)
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=BAAI/bge-m3

# ch04 新增:bge-reranker-v2-m3 重排(硅基流动 /v1/rerank;留空则复用 EMBEDDING_API_KEY)
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ch09 Langfuse 自部署(缺 key 或 SDK 时自动 no-op,不阻断聊天)
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_HOST=http://127.0.0.1:3000
# LANGFUSE_RELEASE=shophelper-ch09
# LANGFUSE_TRACING_ENVIRONMENT=development
# EVIDENCE_CALIBRATION_PATH=config/evidence_calibration.json  # 证据闸阈值,scripts/gen_evidence_signals.py 校准生成

# ch08 新增:即插即用工具系统
# MCP_LOGISTICS_URL=http://127.0.0.1:8001/mcp   # 物流 MCP Server(Streamable HTTP,独立进程)
# MCP_AFTERSALES_URL=http://127.0.0.1:8002/mcp  # 售后 MCP Server(Streamable HTTP,独立进程)
# TOOLS_DEBUG=true                              # 注册 debug 慢工具(人为制造超时,验收用,默认 false)
# TOOL_TIMEOUT_SECONDS=10                       # 单次工具执行超时
# TOOL_RETRY_ATTEMPTS=1                         # 读操作暂时性故障重试次数;写操作恒不重试

# ch10 新增:微调主题分类器(旁路批量归类;模型缺失时接口 503 不影响聊天,全部有默认值)
# TOPIC_MODEL_DIR=models/topic_classifier   # 训练/导出产物目录
# TOPIC_THRESHOLD=0.5                       # sigmoid 阈值(label_config.json 有值时以其为准)
# TOPIC_MAX_LEN=96
# TOPIC_BATCH_SIZE=16
# TOPIC_CLASSIFY_BATCH_LIMIT=200            # 后台页「归类一批」单批上限

# ch14 新增:后台管理员鉴权(先 apply db/ch14-admin-auth.sql,再用 scripts.adminctl 创建管理员)
# 生成密钥:python -c 'import secrets; print(secrets.token_urlsafe(48))'
# ADMIN_SESSION_SECRET=                     # 必填;为空时后台登录 503,聊天不受影响
# ADMIN_SESSION_TTL_SECONDS=28800           # 会话有效期,默认 8 小时
# ADMIN_COOKIE_SECURE=false                 # 本地 HTTP 为 false;生产 HTTPS 必须 true
# ADMIN_LOGIN_MAX_FAILURES=5                # 连续失败锁定阈值
# ADMIN_LOGIN_LOCK_SECONDS=900              # 锁定秒数
# ADMIN_PASSWORD_ITERATIONS=600000          # PBKDF2-HMAC-SHA256 迭代次数

# ch12 新增:受控 Agentic RAG(先 apply db/ch12-controlled-rag.sql;默认 hybrid_rerank 图零变化)
# 新路由在新语料重新校准并验证前不得设为生产默认(ADR-5,当前校准 calibration_status=stale)
# RETRIEVAL_ROUTE=hybrid_rerank             # hybrid_rerank | decompose_once | controlled_loop
# MAX_RAG_ROUNDS=3                          # controlled_loop 最大补检索轮数(不含首轮)
# RAG_TOKEN_BUDGET=3000                     # 循环内判断+分析调用的输入+输出估算 token 预算
# RAG_TIME_BUDGET_S=45                      # 循环墙钟预算(秒);不是硬上限,底层 I/O 无法取消
# RAG_CALL_TIMEOUT_S=20                     # 单次检索/判断/分析调用的墙钟上限(秒);0=只用剩余时间
# RAG_MAX_SUB_QUERIES=3                     # 每轮最多子查询数

# 二轮优化实验入口；默认均关闭，返回旧单 Agent / 多 Agent raw 行为
# ADAPTIVE_ROUTING_ENABLED=false
# MULTI_AGENT_HANDOFF_MODE=raw              # raw | typed
# MULTI_AGENT_DYNAMIC_STATUS_TTL_SECONDS=300
# MULTI_AGENT_ACTION_CONTRACTS_ENABLED=false # R3 dev 仅显示动作更少,默认关闭
# ANSWER_VERIFICATION_ENABLED=false
# CLAIM_GROUNDING_ENABLED=false
# CLAIM_GROUNDING_LEDGER_PATH=             # 开启 claim grounding 时必填
# CLAIM_GROUNDING_MAX_COST_USD=2.0
# CLAIM_GROUNDING_RESERVE_USD=0.005
# ANSWER_PLAN_ENABLED=false                 # R3 held-out 为负结果,默认关闭
# ANSWER_PLAN_LEDGER_PATH=                  # 开启时必填的独立 SQLite 账本
# ANSWER_PLAN_MAX_COST_USD=2.0
# ANSWER_PLAN_PRICING_PATH=config/pricing.yaml
# RAG_GAP_TRIGGER_ENABLED=false

# Optional retrieval evidence slate. Keeps one rerank call but selects the final
# top-k from a 50-chunk pool by explicit entity/policy facets. See
# docs/eval/retrieval-evidence-slate-report.md before enabling.
# RETRIEVAL_EVIDENCE_SLATE_ENABLED=false
# RETRIEVAL_RERANK_POOL_K=50
