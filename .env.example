# 复制为 .env 并填入真实值;.env 不进 git
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
HISTORY_TOKEN_BUDGET=3000
CHAT_TEMPERATURE=0.7
EXTRACT_TEMPERATURE=0
# ch02 新增:MySQL 连接串(Docker 起库后默认值即可用)
DATABASE_URL=mysql+pymysql://shophelper:shophelper@127.0.0.1:3306/shophelper?charset=utf8mb4
# ch03 新增:BGE-M3 嵌入(硅基流动 OpenAI 兼容接口,https://cloud.siliconflow.cn 申请 key)
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=BAAI/bge-m3
