# 复制为 .env 并填入真实值;.env 不进 git
# 对话:智谱 GLM(OpenAI 兼容接口,https://open.bigmodel.cn 申请 key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4.7-flash
# 其他 OpenAI 兼容上游(如 DeepSeek)改后两行即可:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# ch07 新增:上下文预算从模型窗口倒推(历史预算=min(想留轮数×每轮稳态, 滑窗),层1 七成/层2 三成)
# 只调 MODEL_CONTEXT_WINDOW 不够:固定开销与单轮峰值按其余默认值算,窗口过小会滑窗归零并报「上下文预算不足」
# MODEL_CONTEXT_WINDOW=65536
# MAX_OUTPUT_TOKENS=2000
# MAX_USER_INPUT_TOKENS=2000
# MAX_AGENT_STEPS=6
# TOOL_RESULT_MAX_TOKENS=2000
# RERANK_TOP_K=10
CHAT_TEMPERATURE=0.7
EXTRACT_TEMPERATURE=0
# ch02 新增:MySQL 连接串(Docker 起库后默认值即可用)
DATABASE_URL=mysql+pymysql://shophelper:shophelper@127.0.0.1:3306/shophelper?charset=utf8mb4
# ch03 新增:BGE-M3 嵌入(硅基流动 OpenAI 兼容接口,https://cloud.siliconflow.cn 申请 key)
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=BAAI/bge-m3

# ch04 新增:bge-reranker-v2-m3 重排(硅基流动 /v1/rerank;留空则复用 EMBEDDING_API_KEY)
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ch09 Langfuse 自部署(缺 key 或 SDK 时自动 no-op,不阻断聊天)
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_HOST=http://127.0.0.1:3000
# LANGFUSE_RELEASE=shophelper-ch09
# LANGFUSE_TRACING_ENVIRONMENT=development
# EVIDENCE_CALIBRATION_PATH=data/evidence_calibration.json

# ch08 新增:即插即用工具系统
# MCP_LOGISTICS_URL=http://127.0.0.1:8001/mcp   # 物流 MCP Server(Streamable HTTP,独立进程)
# MCP_AFTERSALES_URL=http://127.0.0.1:8002/mcp  # 售后 MCP Server(Streamable HTTP,独立进程)
# TOOLS_DEBUG=true                              # 注册 debug 慢工具(人为制造超时,验收用,默认 false)
# TOOL_TIMEOUT_SECONDS=10                       # 单次工具执行超时
# TOOL_RETRY_ATTEMPTS=1                         # 读操作暂时性故障重试次数;写操作恒不重试
